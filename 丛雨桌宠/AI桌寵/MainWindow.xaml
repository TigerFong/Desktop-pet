<Window x:Class="SmartDesktopPet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="丛雨" 
        Height="1100" Width="750"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent" 
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Left="900"
        Top="280"
        PreviewMouseWheel="Window_PreviewMouseWheel">

    <!-- 🌸 加上 Background="#01000000"（極微透黑色），防止透明區域事件穿透透給桌面 -->
    <Grid x:Name="RootGrid" Background="#01000000">
        <!-- 整體 UI 縮放變換 -->
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="UiScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
        </Grid.LayoutTransform>

        <!-- 1. 角色立繪 -->
        <Image x:Name="PetImage" 
               Source="/Images/Shendao/normal.png"
               Stretch="Uniform"
               Width="1500" Height="1000"
               HorizontalAlignment="Center" 
               VerticalAlignment="Bottom"
               Margin="0,0,0,25"
               MouseLeftButtonDown="PetImage_MouseLeftButtonDown"
               MouseMove="PetImage_MouseMove"
               MouseLeftButtonUp="PetImage_MouseLeftButtonUp">
            <Image.ContextMenu>
                <ContextMenu>
                    <!-- 🌸 縮放模式開關 -->
                    <MenuItem x:Name="MenuToggleScaleMode" 
                              Header="🔍 縮放模式 (開啟後 Shift + 滾輪)" 
                              IsCheckable="True" 
                              IsChecked="False" 
                              Click="MenuToggleScaleMode_Click"/>

                    <!-- 👗 服裝切換 -->
                    <MenuItem Header="👗 服裝切換">
                        <MenuItem Header=" 神刀服" Click="MenuCostume_Click" Tag="Shendao"/>
                        <MenuItem Header=" 學校制服" Click="MenuCostume_Click" Tag="Uniform"/>
                        <MenuItem Header=" 常服" Click="MenuCostume_Click" Tag="Casual"/>
                        <MenuItem Header=" 浴衣" Click="MenuCostume_Click" Tag="Yukata"/>
                    </MenuItem>
                    <Separator/>
                    <MenuItem x:Name="MenuShowFavorability" Header="查看好感度" Click="MenuShowFavorability_Click"/>
                    <MenuItem x:Name="MenuTodo" Header="待辦事項小幫手" Click="MenuTodo_Click"/>
                    <MenuItem Header="❌ 關閉桌寵" Click="MenuClose_Click"/>
                </ContextMenu>
            </Image.ContextMenu>
        </Image>

        <!-- 2. GALGAME 風格回答框 -->
        <Border x:Name="SpeechBubble" 
                Visibility="Visible"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,450"
                Width="480"
                Background="#00000000" 
                CornerRadius="8" 
                BorderThickness="1.5" 
                Padding="16,12,16,12">

            <Grid>
                <ScrollViewer x:Name="BubbleScrollViewer"
                              MaxHeight="220"
                              VerticalScrollBarVisibility="Auto" 
                              HorizontalScrollBarVisibility="Disabled"
                              Focusable="False">

                    <StackPanel x:Name="BubbleContentPanel" Margin="0,0,0,20">
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="【 叢雨 】" FontSize="22" FontWeight="Bold" Foreground="Black" Margin="-2,-2,0,0"/>
                            <TextBlock Text="【 叢雨 】" FontSize="22" FontWeight="Bold" Foreground="Black" Margin="0,-2,0,0"/>
                            <TextBlock Text="【 叢雨 】" FontSize="22" FontWeight="Bold" Foreground="Black" Margin="2,-2,0,0"/>
                            <TextBlock Text="【 叢雨 】" FontSize="22" FontWeight="Bold" Foreground="Black" Margin="-2,0,0,0"/>
                            <TextBlock Text="【 叢雨 】" FontSize="22" FontWeight="Bold" Foreground="Black" Margin="2,0,0,0"/>
                            <TextBlock Text="【 叢雨 】" FontSize="22" FontWeight="Bold" Foreground="Black" Margin="-2,2,0,0"/>
                            <TextBlock Text="【 叢雨 】" FontSize="22" FontWeight="Bold" Foreground="Black" Margin="0,2,0,0"/>
                            <TextBlock Text="【 叢雨 】" FontSize="22" FontWeight="Bold" Foreground="Black" Margin="2,2,0,0"/>
                            <TextBlock Text="【 叢雨 】" FontSize="22" FontWeight="Bold" Foreground="White"/>
                        </Grid>

                        <Border Background="#55000000" CornerRadius="6" Padding="10,8">
                            <TextBlock x:Name="BubbleText" 
                                       Text="哼，主人終於來了啊！本座可是等了主人好久呢。" 
                                       TextWrapping="Wrap" 
                                       FontSize="20" 
                                       LineHeight="28"
                                       Foreground="White"
                                       FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Button Content="✕" 
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Top" 
                        Width="28" Height="28"
                        Background="#55000000" 
                        Foreground="White" 
                        FontWeight="Bold"
                        FontSize="14"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="CloseBubbleButton_Click"
                        ToolTip="關閉對話框">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="14">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- 3. 輸入框 -->
        <Border x:Name="InputPanel"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,450"
                Width="480"
                Height="50"
                Background="#55000000" 
                CornerRadius="8"
                BorderBrush="#88FFFFFF"
                BorderThickness="1.5"
                Padding="6">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" Color="Black" Opacity="0.3" Direction="270" ShadowDepth="2"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="MicButton" Grid.Column="0"
                        Content="🎤" Margin="0,0,6,0"
                        Click="MicButton_Click"
                        Background="#CC4CAF50" Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0" Width="35"
                        ToolTip="點擊開始語音輸入"/>

                <TextBox x:Name="InputTextBox" Grid.Column="1"
                         VerticalContentAlignment="Center"
                         FontSize="15" Padding="8,4"
                         Background="Transparent" 
                         Foreground="White"
                         CaretBrush="White" 
                         BorderThickness="0"
                         KeyDown="InputTextBox_KeyDown"/>

                <Button x:Name="SendButton" Grid.Column="2"
                        Content="發送" Margin="6,0,0,0"
                        Click="SendButton_Click"
                        Background="#CCFFEB3B" Foreground="Black"
                        FontWeight="Bold"
                        BorderThickness="0" Padding="16,4"/>
            </Grid>
        </Border>
    </Grid>
</Window>