  <ItemGroup>
    <Content Include="SystemPrompt.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.63.0" />
    <PackageReference Include="System.Speech" Version="10.0.12" />
    <PackageReference Include="WpfAnimatedGif" Version="2.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Images\Casual\angry.png" />
    <Resource Include="Images\Casual\dislike.png" />
    <Resource Include="Images\Casual\happy.png" />
    <Resource Include="Images\Casual\normal.png" />
    <Resource Include="Images\Casual\shy.png" />
    <Resource Include="Images\Casual\surprise.png" />
    <Resource Include="Images\Shendao\angry.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Images\Shendao\dislike.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Images\Shendao\happy.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Images\Shendao\normal.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Images\Shendao\shy.png" />
    <Resource Include="Images\Shendao\surprise.png" />
    <Resource Include="Images\Uniform\angry.png" />
