    <None Remove="Images\normal.png" />
    <None Remove="Images\pet.png" />
    <None Remove="Images\pet_happy.gif" />
    <None Remove="Images\pet_normal.gif" />
    <None Remove="Images\pet_surprised.gif" />
    <None Remove="Images\pet_talking.gif" />
    <None Remove="Images\pet_thinking.gif" />
    <None Remove="Images\shy.png" />
    <None Remove="Images\surprise.png" />
    <None Remove="Images\Uniform\angry.png" />
    <None Remove="Images\Uniform\dislike.png" />
