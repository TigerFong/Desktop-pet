<Window x:Class="SmartDesktopPet.TodoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新增待辦事項" 
        Height="220" Width="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="ToolWindow"
        Topmost="True"
        Background="#222222">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. 事項名稱 -->
        <TextBlock Text="待辦事項名稱：" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBox x:Name="TaskInputBox" Grid.Row="1" Height="30" FontSize="14" VerticalContentAlignment="Center" Padding="4"/>

        <!-- 2. 時間設定提示 -->
        <TextBlock Text="提醒時間 (格式: yyyy/MM/dd/HH/mm)：" Foreground="#CCCCCC" FontSize="12" Margin="0,10,0,4" Grid.Row="2"/>

        <!-- 3. 輸入框與確認按鈕列 -->
        <Grid Grid.Row="3" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="TimeInputBox" Grid.Column="0" Height="30" FontSize="14" VerticalContentAlignment="Center" Padding="4" Margin="0,0,8,0"/>
            <Button x:Name="ConfirmButton" Grid.Column="1" Content="新增並排程" Width="90" Height="30" FontWeight="Bold" Background="#CC4CAF50" Foreground="White" Click="ConfirmButton_Click"/>
        </Grid>
    </Grid>
</Window>